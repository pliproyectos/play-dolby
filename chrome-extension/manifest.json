{
  "manifest_version": 3,
  "name": "PLI Espacial 7.1",
  "version": "2026.10.22",
  "description": "Convierte el audio estéreo de una pestaña (YouTube Music, etc.) en 7.1 para el domo. PLI Ingeniería Aplicada.",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "action": {
    "default_title": "PLI Espacial 7.1",
    "default_popup": "popup.html",
    "default_icon": { "16": "iconos/16.png", "48": "iconos/48.png", "128": "iconos/128.png" }
  },
  "icons": { "16": "iconos/16.png", "48": "iconos/48.png", "128": "iconos/128.png" },
  "background": { "service_worker": "service-worker.js" }
}
