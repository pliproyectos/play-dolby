#include "app_resources.h"
IDI_PLI_APP ICON "../assets/pli-app.ico"

LANGUAGE 9, 1
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "ProductVersion", "0.1.0.0\0"
            VALUE "FileDescription", "Play Dolby\0"
            VALUE "ProductName", "Play Dolby\0"
            VALUE "InternalName", "PlayDolby\0"
            VALUE "OriginalFilename", "PlayDolby.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
